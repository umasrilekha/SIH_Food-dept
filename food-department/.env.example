# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/food_department_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# Security & Secret Configuration
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_256_BITS_HERE
JWT_EXPIRATION_MS=1800000

# Inter-Department Service Account Authentication
GOVMESH_SERVICE_API_KEY=YOUR_SECURE_INTER_DEPARTMENT_API_KEY_HERE
GOVMESH_SERVICE_JWT_SECRET=YOUR_SECURE_SERVICE_ACCOUNT_JWT_SECRET_HERE

# CORS Configuration (Comma-separated trusted origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Development / Production Toggles
ENABLE_H2_CONSOLE=false

# Server & Frontend Configuration
SERVER_PORT=8081
VITE_API_BASE_URL=http://localhost:8081/api
